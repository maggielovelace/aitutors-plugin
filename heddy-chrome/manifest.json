{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Heddy",
  "description": "__MSG_extDescription__",
  "version": "0.6.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "homepage_url": "https://aitutors.me",
  "icons": {
    "16": "icons/toolbar-16.png",
    "32": "icons/toolbar-32.png",
    "48": "icons/toolbar-48.png",
    "128": "icons/store-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "32": "icons/toolbar-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "contextMenus", "commands", "storage"],
  "host_permissions": [
    "https://www.youtube.com/watch*",
    "https://aitutors.me/*",
    "https://*.aitutors.me/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": [
        "lib/font-data.js",
        "lib/fonts.js",
        "lib/messages.js",
        "lib/i18n.js",
        "lib/protocol.js",
        "lib/config.js",
        "lib/marks.js",
        "lib/toast.js",
        "lib/jot-key.js",
        "lib/desk-model.js",
        "lib/film-strip.js",
        "lib/desk-ask.js",
        "lib/ask-view.js",
        "lib/desk-shell.js",
        "content/youtube-selectors.js",
        "content/desk.js",
        "content/youtube.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "jot-selection": {
      "description": "__MSG_commandJot__"
    },
    "snap-picture": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "__MSG_cmdSnap__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup/popup.html",
        "popup/popup.css",
        "popup/popup.js",
        "lib/messages.js",
        "lib/i18n.js",
        "lib/protocol.js",
        "lib/config.js",
        "lib/marks.js",
        "lib/courier.js",
        "lib/tray-tools.js",
        "lib/cards.js",
        "lib/page-kind.js",
        "lib/who.js",
        "lib/snap.js",
        "lib/film-strip.js",
        "lib/desk-ask.js",
        "lib/desk-shell.js",
        "lib/ask-view.js",
        "popup/web-desk.js",
        "content/youtube-selectors.js",
        "fonts/manrope-latin.woff2",
        "fonts/manrope-latin-ext.woff2"
      ],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ],
  "externally_connectable": {
    "matches": ["https://aitutors.me/*", "http://localhost:3000/*"]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
